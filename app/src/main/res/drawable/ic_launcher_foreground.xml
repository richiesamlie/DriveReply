<!--
  DriveReply adaptive icon foreground.

  Composition (108dp viewport, 66dp safe zone in the center 21..87):
    - Electric-cyan chat bubble (rounded square with a tail at the bottom-left)
    - White steering wheel inside the bubble (3 spokes, thick outer ring, central hub)

  Colors:
    - Bubble:  #00C2FF
    - Wheel:   #FFFFFF
  Keep these two in sync with the same constants used in the Python mipmap
  generator (see tools/generate_launcher_icons.py).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Chat bubble body + tail (single closed path, fill only).
         Body is a 60dp x 42dp rounded rect from (24,28) to (84,70) with 12dp corners.
         Tail descends from (45,70) to (37,80) to (50,70) on the bottom-left. -->
    <path
        android:fillColor="#00C2FF"
        android:pathData="M36,28 L72,28 A12,12 0 0 1 84,40 L84,58 A12,12 0 0 1 72,70 L50,70 L37,80 L45,70 L36,70 A12,12 0 0 1 24,58 L24,40 A12,12 0 0 1 36,28 Z" />

    <!-- Steering wheel outer ring (stroked, no fill) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:fillColor="#00000000"
        android:pathData="M54,49 m -15,0 a 15,15 0 1,0 30,0 a 15,15 0 1,0 -30,0" />

    <!-- 3 spokes (top, bottom-left @ 210°, bottom-right @ 330°), rounded caps -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,49 L54,34" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,49 L41,56.5" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,49 L67,56.5" />

    <!-- Central hub -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,49 m -4,0 a 4,4 0 1,0 8,0 a 4,4 0 1,0 -8,0" />
</vector>
