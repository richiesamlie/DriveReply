<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      FileProvider roots for DriveReply.

      Cache-rooted paths are used by the in-app updater (ApkUpdateInstaller)
      to share the freshly-downloaded APK with the system package installer
      via FileProvider + ACTION_INSTALL_PACKAGE.

      Only the `updates/` subdirectory is exposed; the rest of the cache and
      internal files (databases, DataStore, etc.) remain private.
    -->
    <cache-path
        name="updates"
        path="updates/" />
</paths>
