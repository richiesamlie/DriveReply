<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy auto-backup rules for DriveReply (API 29–30).

  On API 29–30, <full-backup-content> excludes sensitive content (Room DB,
  DataStore preferences) from Google Cloud Auto Backup. On API 31+
  (see data_extraction_rules.xml), cloud backup continues to exclude
  the database and DataStore while explicit user-initiated device-to-device
  transfers (<device-transfer>) preserve templates and preferences when
  migrating to a new phone.

  Note: <domain="cache"> is not a valid backup-rules domain, and the
  app's cache is excluded by default anyway. The in-app updater's
  downloaded APKs therefore need no explicit rule.

  See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!--
      Exclude the Room database (templates, template rules, reply log)
      from auto-backup. These contain user-authored content that can be
      sensitive.
    -->
    <exclude domain="database" path="drivereply.db" />
    <exclude domain="database" path="drivereply.db-shm" />
    <exclude domain="database" path="drivereply.db-wal" />

    <!--
      Exclude DataStore preferences. Includes the user-selected car
      Bluetooth MAC addresses, service enable toggle, and debug-log
      preference.
    -->
    <exclude domain="file" path="datastore/" />
</full-backup-content>
