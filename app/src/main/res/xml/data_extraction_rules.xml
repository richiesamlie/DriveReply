<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for DriveReply (API 31+).

  Cloud backup excludes sensitive content. Device-to-device transfer
  keeps the user's data so they don't lose their templates and reply
  log when they move to a new phone. See backup_rules.xml for the
  rationale. The in-app updater's cache is excluded by default.

  See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="drivereply.db" />
        <exclude domain="database" path="drivereply.db-shm" />
        <exclude domain="database" path="drivereply.db-wal" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
